# Optional. Without these the server runs fully offline with the rules-based planner and the browser voice.
PORT=8787
BRAIN=offline            # offline | nemotron
NEBIUS_API_KEY=          # Nebius Token Factory key, needed for BRAIN=nemotron
NEMOTRON_MODEL=          # optional: pin the review model; default is the newest Nemotron Super listed
NEMOTRON_FAST_MODEL=     # optional: pin the question model; default is the newest Nemotron Nano listed
VOICE=browser            # browser | polly
POLLY_ENGINE=generative  # generative | neural
POLLY_VOICE=Ruth
AWS_REGION=us-east-1
CORS_ORIGINS=*
